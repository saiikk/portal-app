{
  "info": {
    "name": "Portal App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "group_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "List Groups",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/groups", "host": ["{{base_url}}"], "path": ["groups"] }
          }
        },
        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Group\"\n}"
            },
            "url": { "raw": "{{base_url}}/groups", "host": ["{{base_url}}"], "path": ["groups"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.id) pm.collectionVariables.set('group_id', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Group Messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}", "messages"]
            }
          }
        },
        {
          "name": "Send Group Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Hello group\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}", "messages"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "New Graduates",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/new-graduates", "host": ["{{base_url}}"], "path": ["users", "new-graduates"] }
          }
        },
        {
          "name": "Employees",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/employees", "host": ["{{base_url}}"], "path": ["users", "employees"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Show Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Name\",\n  \"email\": \"new@example.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"] }
          }
        }
      ]
    }
  ]
}
